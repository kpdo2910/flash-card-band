{
  "name": "cardband",
  "version": "0.1.0",
  "private": true,
  "description": "Flash Card - Japanese flashcards with FSRS-6 for Xiaomi Smart Band 11 (Xiaomi Vela quick app)",
  "license": "MIT",
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release",
    "deck": "node --disable-warning=ExperimentalWarning tools/build-deck.js",
    "icon": "node tools/make-icon.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test --watch \"tests/**/*.test.js\"",
    "authkey": "node tools/mi-authkey.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "aiot-toolkit": "^2.0.5"
  }
}
