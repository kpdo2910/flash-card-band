<template>
  <list class="page {{ pageAnim }}">
    <list-item type="space" class="row-space"></list-item>
    <list-item type="head" class="row-head">
      <text class="head">Cài đặt</text>
    </list-item>
    <list-item for="{{ rows }}" type="row" class="row" @click="open($item.key)">
      <div class="row-box">
        <text class="row-title">{{ $item.title }}</text>
        <div class="row-line">
          <text class="row-value">{{ $item.value }}</text>
          <text class="chevron">›</text>
        </div>
      </div>
    </list-item>
    <list-item type="danger" class="row-danger">
      <text class="danger" @longpress="reset">Giữ lâu để xoá tiến độ</text>
    </list-item>
    <list-item type="version" class="row-version">
      <text class="version">Flash Card 0.1.0 · FSRS-6</text>
    </list-item>
    <list-item type="space" class="row-space"></list-item>
  </list>
</template>

<style>
.page {
  width: 212px;
  height: 520px;
  flex-direction: column;
  background-color: #000000;
  opacity: 1;
  transition-property: opacity;
  transition-duration: 180ms;
  transition-timing-function: ease-in-out;
}
.page-hidden {
  opacity: 0;
}
.row-space {
  width: 212px;
  height: 40px;
}
.row-head {
  width: 212px;
  height: 40px;
  justify-content: center;
  align-items: center;
}
.head {
  font-size: 20px;
  color: #ffffff;
}
.row {
  width: 212px;
  height: 72px;
  justify-content: center;
  align-items: center;
}
.row-box {
  width: 176px;
  height: 62px;
  flex-direction: column;
  justify-content: center;
  border-radius: 16px;
  background-color: #1c1c1e;
  padding-left: 14px;
  padding-right: 10px;
}
.row-title {
  font-size: 13px;
  height: 20px;
  color: #8e8e93;
}
.row-line {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 152px;
  height: 28px;
}
.row-value {
  font-size: 18px;
  color: #ffffff;
}
.chevron {
  font-size: 22px;
  color: #636366;
}
.row-danger {
  width: 212px;
  height: 64px;
  justify-content: center;
  align-items: center;
}
.danger {
  width: 176px;
  height: 56px;
  font-size: 16px;
  color: #e74c3c;
  text-align: center;
}
.row-version {
  width: 212px;
  height: 30px;
  justify-content: center;
  align-items: center;
}
.version {
  font-size: 12px;
  color: #48484a;
  text-align: center;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { settingsRows } from '../../presentation/settingsOptions.js'

export default {
  private: {
    rows: [],
    pageAnim: 'page-hidden'
  },

  onInit() {
    this.refresh()
  },

  onShow() {
    // Coming back from the selection page.
    this.refresh()
    this.fadeIn()
  },

  onHide() {
    this.pageAnim = 'page-hidden'
  },

  onBackPress() {
    this.leave(function () { router.back() })
    return true
  },

  // --- page cross-fade -------------------------------------------------------
  fadeIn() {
    var self = this
    this.pageAnim = 'page-hidden'
    if (this.pageTimer) clearTimeout(this.pageTimer)
    this.pageTimer = setTimeout(function () { self.pageAnim = '' }, 20)
  },

  leave(fn) {
    var self = this
    if (this.leaving) return
    this.leaving = true
    this.pageAnim = 'page-hidden'
    if (this.pageTimer) clearTimeout(this.pageTimer)
    this.pageTimer = setTimeout(function () {
      self.leaving = false
      fn()
    }, 170)
  },


  refresh() {
    var self = this
    this.$app.$def.container.settingsRepository.load().then(function (s) {
      self.rows = settingsRows(s)
    })
  },

  open(key) {
    this.leave(function () { router.push({ uri: '/pages/select', params: { key: key } }) })
  },

  reset() {
    this.$app.$def.container.resetProgress().then(function () {
      prompt.showToast({ message: 'Đã xoá tiến độ', duration: 1500 })
    })
  }
}
</script>
